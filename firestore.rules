rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGuardian(guardianId) {
      return signedIn() && request.auth.uid == guardianId;
    }

    function validLearningStage(schoolLevel, grade) {
      return schoolLevel is string && grade is int && (
        (schoolLevel == 'kindergarten' && grade >= 5 && grade <= 7) ||
        (schoolLevel == 'elementary' && grade >= 1 && grade <= 6) ||
        (schoolLevel == 'middle' && grade >= 1 && grade <= 3)
      );
    }

    function isRoomGuardian(roomId) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return signedIn()
        && room.guardianUids is list
        && room.guardianUids.hasAny([request.auth.uid])
        && room.expiresAt is timestamp
        && request.time < room.expiresAt;
    }

    // Preserve the existing StudyMate owner-only user document boundary.
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /guardians/{guardianId} {
      allow read: if isGuardian(guardianId);
      allow create, update: if isGuardian(guardianId)
        && request.resource.data.keys().hasOnly([
          'displayName', 'childProfileIds', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 50
        && request.resource.data.childProfileIds is list
        && request.resource.data.childProfileIds.size() <= 10;
      allow delete: if false;

      match /children/{childId} {
        allow read: if isGuardian(guardianId);
        allow create: if isGuardian(guardianId)
          && request.resource.data.keys().hasOnly([
            'displayName', 'schoolLevel', 'grade', 'characterId', 'friendCode',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 1
          && request.resource.data.displayName.size() <= 20
          && validLearningStage(request.resource.data.schoolLevel, request.resource.data.grade)
          && request.resource.data.characterId is string
          && request.resource.data.characterId.size() >= 1
          && request.resource.data.characterId.size() <= 40
          && request.resource.data.characterId.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
          && request.resource.data.friendCode is string
          && request.resource.data.friendCode.matches('^[A-HJ-NP-Z2-9]{8}$');
        allow update: if isGuardian(guardianId)
          && request.resource.data.keys().hasOnly([
            'displayName', 'schoolLevel', 'grade', 'characterId', 'friendCode',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 1
          && request.resource.data.displayName.size() <= 20
          && validLearningStage(request.resource.data.schoolLevel, request.resource.data.grade)
          && request.resource.data.characterId is string
          && request.resource.data.characterId.size() >= 1
          && request.resource.data.characterId.size() <= 40
          && request.resource.data.characterId.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
          && request.resource.data.friendCode is string
          && request.resource.data.friendCode.matches('^[A-HJ-NP-Z2-9]{8}$')
          && request.resource.data.friendCode == resource.data.friendCode
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isGuardian(guardianId);

        // Progress, learning results, and inventory are authoritative server data.
        // Only the Admin SDK route may read or mutate these documents.
        match /gameState/{documentId} {
          allow read, write: if false;
        }
      }

      match /friendApprovals/{approvalId} {
        allow read: if isGuardian(guardianId);
        allow create, update: if isGuardian(guardianId)
          && request.resource.data.keys().hasOnly([
            'friendGuardianUid', 'status', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.friendGuardianUid is string
          && request.resource.data.friendGuardianUid != guardianId
          && request.resource.data.status in ['pending', 'approved', 'blocked'];
        allow delete: if isGuardian(guardianId);
      }
    }

    match /rooms/{roomId} {
      allow read: if signedIn()
        && resource.data.guardianUids is list
        && resource.data.guardianUids.hasAny([request.auth.uid])
        && resource.data.expiresAt is timestamp
        && request.time < resource.data.expiresAt;
      // Room lifecycle is changed only by Admin SDK / the server authority.
      allow create, update, delete: if false;

      match /commands/{eventId} {
        // Commands are validated and written only by the authenticated Route
        // Handler through the Admin SDK. Clients never write raw answer data.
        allow read, create, update, delete: if false;
      }

      match /publicState/{documentId} {
        allow read: if isRoomGuardian(roomId);
        allow write: if false;
      }

      match /privateMembers/{childId} {
        allow read: if isRoomGuardian(roomId);
        allow write: if false;
      }

      match /results/{documentId} {
        allow read: if isRoomGuardian(roomId);
        allow write: if false;
      }
    }

    match /roomCodes/{roomCode} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
