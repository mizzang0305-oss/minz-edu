# Firebase Web SDK public configuration (safe to expose to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=replace-me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-me
# Public reCAPTCHA Enterprise site key. Keep Firebase product enforcement off
# until monitoring metrics and two-device staging validation are accepted.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=replace-me
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Firebase Admin SDK server-only credentials (never prefix with NEXT_PUBLIC_)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"

# Local alternative: path to an ignored Firebase service-account JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=C:\absolute\path\.firebase-admin-key.json

# Parent learning-session email (server-only; verify the sender domain in Resend)
PARENT_REPORT_EMAIL_ENABLED=false
RESEND_API_KEY=replace-me
PARENT_REPORT_FROM_EMAIL="Minz Adventure <reports@example.com>"
